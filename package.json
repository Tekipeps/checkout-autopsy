{
  "name": "checkout-autopsy",
  "version": "0.1.0",
  "description": "An agent that reproduces and repairs duplicate checkout fulfillment inside CreateOS Sandbox.",
  "scripts": {
    "check": "tsc --noEmit",
    "doctor": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/doctor.ts",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "sandbox:smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/smoke.ts",
    "test:agent-loop": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/test-agent-loop.ts",
    "validate:production": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/validate-production.ts",
    "evidence:production": "node --import tsx scripts/summarize-production.ts",
    "secrets:check": "node scripts/check-secrets.mjs",
    "build:showcase": "node scripts/build-showcase.mjs"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@nodeops-createos/sandbox": "^0.8.2",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
