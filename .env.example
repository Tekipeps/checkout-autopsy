# Secrets stay on the server. Never prefix API keys with VITE_.
# Stripe Projects manages .env; personal overrides belong in ignored .env.local.
CREATEOS_SANDBOX_API_KEY=
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh

# Optional: connect the live repair agent. No key is needed for guided mode.
OPENROUTER_API_KEY=
MODEL_NAME=cohere/north-mini-code:free
# For another compatible model endpoint, set these instead:
# MODEL_API_KEY=
# MODEL_BASE_URL=https://your-provider.example/v1

# Defaults for local development:
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
